# QCF example environment
#
# Copy to `.env` for local development. `.env` is git-ignored and must never be
# committed.
#
# This file may only ever contain non-financial development settings.
# It must NEVER contain:
#   - broker or prop-firm credentials
#   - API keys or tokens
#   - account identifiers
#   - trading-platform endpoints
#
# QCF has no live mode and no broker connectivity, so there is nothing here to
# authenticate against. If a future change appears to need a credential in this
# file, that change is out of scope for this repository. See SECURITY.md.

# Operating mode: DISABLED, RESEARCH, BACKTEST, REPLAY, or PAPER.
# There is no LIVE mode. DISABLED is the default.
QCF_MODE=DISABLED

# Label for this machine or context. Carries no behaviour.
QCF_ENVIRONMENT=local

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
QCF_LOG_LEVEL=INFO

# "console" for humans, "json" for machines.
QCF_LOG_FORMAT=console

# Absolute path that relative data and report paths resolve against. Setting it
# makes a run independent of the working directory it was started from.
# QCF_BASE_PATH=/absolute/path/to/checkout

# Seed for deterministic runs.
QCF_RANDOM_SEED=0
